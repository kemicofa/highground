# CurseForge packager (repository webhook): the addon folder is Warboard,
# not the repository name, and only runtime files ship. Keep this list in
# step with scripts/build.py; tests/test_release.py checks both agree.
package-as: Warboard

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .pkgmeta
  - .claude
  - scripts
  - tests
  # Named files, not wildcards: CurseForge's packager ignored "sounds/*.py".
  - sounds/go_source.py
  - sounds/lockon_source.py
  - sounds/bounty_source.py
