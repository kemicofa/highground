# CurseForge packager (repository webhook) for the Highground project. The
# repository holds several addons in addons/; this project ships only
# addons/Highground, moved to the top as the Highground folder (the same layout
# DBM uses). Everything else is ignored. Keep the ignore list in step with
# scripts/build.py; tests/test_pkgmeta.py checks both agree. "package-as" also
# tells scripts/addons.py which addon publishes through GitHub releases.
package-as: Highground

move-folders:
  Highground/addons/Highground: Highground

manual-changelog:
  filename: addons/Highground/CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .pkgmeta
  - .claude
  - LICENSE
  - README.md
  - docs
  - scripts
  - tests
  - tools
  - addons/HighgroundMacros
  - addons/HighgroundArena
  - addons/Highground/tests
  - addons/Highground/standalone
