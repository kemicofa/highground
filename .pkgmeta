# CurseForge packager (repository webhook) for the Warboard project. The
# repository holds several addons in addons/; this project ships only
# addons/Warboard, moved to the top as the Warboard folder (the same layout
# DBM uses). Everything else is ignored. Keep the ignore list in step with
# scripts/build.py; tests/test_release.py checks both agree.
package-as: Warboard

move-folders:
  Warboard/addons/Warboard: Warboard

manual-changelog:
  filename: addons/Warboard/CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .pkgmeta
  - .claude
  - LICENSE
  - README.md
  - scripts
  - tests
  - addons/WarboardMacros
  - addons/Warboard/tests
  # Named files, not wildcards: CurseForge's packager ignored "sounds/*.py".
  - addons/Warboard/sounds/go_source.py
  - addons/Warboard/sounds/lockon_source.py
  - addons/Warboard/sounds/bounty_source.py
