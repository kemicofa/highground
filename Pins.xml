<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- Map pin template for Pins.lua (same shape as Blizzard's flag pins). -->
  <Script file="Pins.lua"/>
  <Frame name="WarboardPinTemplate" hidden="true" enableMouse="true" mixin="WarboardPinMixin" virtual="true">
    <Size x="22" y="22"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Mark" file="Interface\CHARACTERFRAME\TempPortraitAlphaMask" hidden="true">
          <Size x="30" y="30"/>
          <Anchors><Anchor point="CENTER"/></Anchors>
        </Texture>
      </Layer>
      <Layer level="BORDER">
        <Texture parentKey="Ring" file="Interface\CHARACTERFRAME\TempPortraitAlphaMask">
          <Anchors><Anchor point="TOPLEFT"/><Anchor point="BOTTOMRIGHT"/></Anchors>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <Texture parentKey="Icon">
          <Size x="15" y="15"/>
          <Anchors><Anchor point="CENTER"/></Anchors>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <FontString parentKey="Label" inherits="GameFontNormalOutline">
          <Anchors><Anchor point="TOP" relativePoint="BOTTOM" y="-1"/></Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>
</Ui>
