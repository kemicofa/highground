<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- Map pin template for Pins.lua (same shape as Blizzard's flag pins). -->
  <Script file="Pins.lua"/>
  <Frame name="HighgroundPinTemplate" hidden="true" enableMouse="true" mixin="HighgroundPinMixin" virtual="true">
    <Size x="22" y="22"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Mark" file="Interface\CHARACTERFRAME\TempPortraitAlphaMask" hidden="true">
          <Size x="30" y="30"/>
          <Anchors><Anchor point="CENTER"/></Anchors>
        </Texture>
      </Layer>
      <Layer level="BORDER">
        <Texture parentKey="Ring" file="Interface\CHARACTERFRAME\TempPortraitAlphaMask">
          <Anchors><Anchor point="TOPLEFT"/><Anchor point="BOTTOMRIGHT"/></Anchors>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <Texture parentKey="Icon">
          <Size x="15" y="15"/>
          <Anchors><Anchor point="CENTER"/></Anchors>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <FontString parentKey="Label" inherits="GameFontNormalOutline">
          <Anchors><Anchor point="TOP" relativePoint="BOTTOM" y="-1"/></Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>
  <!-- Where an approximate sighting can be: a circle in map units, so it
       scales with the map. Clicks pass through to the map. -->
  <Frame name="HighgroundZonePinTemplate" hidden="true" enableMouse="true" mixin="HighgroundZonePinMixin" virtual="true">
    <Size x="40" y="40"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Rim" file="Interface\CHARACTERFRAME\TempPortraitAlphaMask">
          <Anchors><Anchor point="TOPLEFT" x="-2" y="2"/><Anchor point="BOTTOMRIGHT" x="2" y="-2"/></Anchors>
        </Texture>
      </Layer>
      <Layer level="BORDER">
        <Texture parentKey="Disc" file="Interface\CHARACTERFRAME\TempPortraitAlphaMask">
          <Anchors><Anchor point="TOPLEFT"/><Anchor point="BOTTOMRIGHT"/></Anchors>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <FontString parentKey="Count" inherits="GameFontNormalOutline">
          <Anchors><Anchor point="CENTER"/></Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>
</Ui>
